// 中性版本资源。不声明产品名与原始文件名：镜像名与文件名由外部命名决定，
// 资源里再写一遍只会多出一处可与文件名交叉比对的特征。
#include <windows.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", ""
            VALUE "FileDescription", "Runtime Host"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "LegalCopyright", ""
            VALUE "ProductName", "Runtime Host"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
